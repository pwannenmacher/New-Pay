# Git
.git
.gitignore

# Environment files
# Note: .env is excluded because docker-compose.yml uses env_file directive
# to load environment variables from a separate .env file outside the build context
.env
.env.local
.env.*.local
.env.template

# Secrets / keys (must never enter the build context or image layers)
*.pem
*.key
*.crt
*.p12
*.pfx

# Documentation markdown files (keep docs/ directory for Swagger files)
README.md
SECURITY_TESTS.md
TEST_QUICKSTART.md

# Build artifacts
bin/
dist/
tmp/

# Test files
*_test.go
coverage.out
coverage.html

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker
Dockerfile
.dockerignore
docker-compose.yml

# Development tools
Makefile
