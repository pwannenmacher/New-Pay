# =============================================================================
# NewPay Backend Environment Configuration Template
# =============================================================================
# This file serves as a complete reference for all environment variables
# supported by the backend application. Copy this to .env and customize.
#
# IMPORTANT: Never commit .env files with real credentials to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_TIMEOUT_READ=15s
SERVER_TIMEOUT_WRITE=15s
SERVER_TIMEOUT_IDLE=60s

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Options: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=newpay
DB_PASSWORD=your_secure_password
DB_NAME=newpay_db
# Options: disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=prefer
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# CRITICAL: Generate a persistent ECDSA private key to prevent session
# invalidation on application restart!
#
# Generate with: go run scripts/generate-jwt-keys.go
# Or use: openssl ecparam -genkey -name prime256v1 -noout | openssl ec -outform PEM
#
# Format: Single line with \n escape sequences
# Example: -----BEGIN EC PRIVATE KEY-----\nMHc...\n-----END EC PRIVATE KEY-----\n
#
# See docs/JWT_KEY_MANAGEMENT.md for detailed instructions
JWT_SECRET=-----BEGIN EC PRIVATE KEY-----\nYOUR_GENERATED_KEY_HERE\n-----END EC PRIVATE KEY-----\n
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
SESSION_TIMEOUT=30m

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
# For development, use Mailpit (SMTP port 1025, Web UI port 8025)
# For production, use your SMTP provider (Gmail, SendGrid, etc.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@newpay.local
# Frontend URLs for email verification and password reset
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# -----------------------------------------------------------------------------
# OAuth/SSO Configuration
# -----------------------------------------------------------------------------
# Backend callback URL (where OAuth provider redirects after login)
OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/callback
# Frontend callback URL (where backend redirects user with token)
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth/callback

# Provider 1 Configuration
OAUTH_1_ENABLED=false
OAUTH_1_NAME=Authentik
OAUTH_1_CLIENT_ID=your_client_id
OAUTH_1_CLIENT_SECRET=your_client_secret
OAUTH_1_AUTH_URL=https://your-auth-server.com/application/o/authorize/
OAUTH_1_TOKEN_URL=https://your-auth-server.com/application/o/token/
OAUTH_1_USER_INFO_URL=https://your-auth-server.com/application/o/userinfo/
# Group to Role Mapping (maps OAuth groups to internal roles)
# Format: oauth-group-1:role-1,oauth-group-2:role-2
# Example: newpay-admins:admin,newpay-users:user,newpay-reviewers:reviewer
OAUTH_1_GROUP_MAPPING=
# Claim name containing user groups (default: "groups")
OAUTH_1_GROUPS_CLAIM=groups
# Default role if no groups match (optional)
OAUTH_1_DEFAULT_ROLE=

# Provider 2 Configuration (GitLab example)
OAUTH_2_ENABLED=false
OAUTH_2_NAME=GitLab
OAUTH_2_CLIENT_ID=
OAUTH_2_CLIENT_SECRET=
OAUTH_2_AUTH_URL=https://gitlab.com/oauth/authorize
OAUTH_2_TOKEN_URL=https://gitlab.com/oauth/token
OAUTH_2_USER_INFO_URL=https://gitlab.com/api/v4/user
OAUTH_2_GROUP_MAPPING=
OAUTH_2_GROUPS_CLAIM=groups

# Provider 3 Configuration (Google example)
OAUTH_3_ENABLED=false
OAUTH_3_NAME=Google
OAUTH_3_CLIENT_ID=
OAUTH_3_CLIENT_SECRET=
OAUTH_3_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_3_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_3_USER_INFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
OAUTH_3_GROUP_MAPPING=
OAUTH_3_GROUPS_CLAIM=groups

# Add more providers as needed (up to 50 providers supported)
# Each provider needs: ENABLED, NAME, CLIENT_ID, CLIENT_SECRET,
# AUTH_URL, TOKEN_URL, USER_INFO_URL

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
CORS_EXPOSED_HEADERS=Link
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=300

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Number of requests allowed per duration
RATE_LIMIT_REQUESTS=1000
# Duration window (e.g., 1m, 1h)
RATE_LIMIT_DURATION=1m

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Options: development, staging, production
APP_ENV=development
APP_NAME=NewPay
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Registration Settings
# -----------------------------------------------------------------------------
# Allow new user registration via email/password
ENABLE_REGISTRATION=false
# Allow new user registration via OAuth providers
ENABLE_OAUTH_REGISTRATION=true
# Note: The first user to register automatically becomes an Admin

# -----------------------------------------------------------------------------
# Scheduler Configuration
# -----------------------------------------------------------------------------
# Enable/disable scheduled tasks
SCHEDULER_ENABLE_DRAFT_REMINDERS=true
SCHEDULER_ENABLE_REVIEWER_SUMMARY=true
SCHEDULER_ENABLE_HASH_CHAIN_VALIDATION=true

# Cron expressions (minute hour day month weekday)
# Draft reminders: Check for stale draft assessments
SCHEDULER_DRAFT_REMINDER_CRON=0 9 * * 1
# Reviewer summary: Send daily summary to reviewers
SCHEDULER_REVIEWER_SUMMARY_CRON=0 8 * * *
# Hash chain validation: Validate audit log integrity
SCHEDULER_HASH_CHAIN_VALIDATION_CRON=0 3 * * *

# Reminder interval for draft assessments (in minutes)
# Default: 10080 minutes = 7 days
# Examples: 1440 = 1 day, 4320 = 3 days, 10080 = 7 days, 20160 = 14 days
SCHEDULER_REMINDER_INTERVAL_MINS=10080

# -----------------------------------------------------------------------------
# Vault Configuration (Key Management Service)
# -----------------------------------------------------------------------------
# HashiCorp Vault for encryption key management
# See docs/ENCRYPTION.md for setup instructions
VAULT_ENABLED=true
VAULT_ADDR=http://localhost:8200
# IMPORTANT: In production, use a secure token from Vault initialization
# For development with docker-compose, use the root token
VAULT_TOKEN=hvs.your_vault_token
VAULT_TRANSIT_MOUNT=transit

# -----------------------------------------------------------------------------
# LLM Configuration (Large Language Model)
# -----------------------------------------------------------------------------
# Ollama for local LLM support (optional feature)
# See docker/llm/docker-compose.yml to run Ollama locally
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434
# Model name (e.g., llama3, mistral, codellama)
LLM_MODEL=llama3
