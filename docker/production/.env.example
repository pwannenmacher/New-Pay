# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=newpay_prod
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=newpay_prod
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_TIMEOUT_READ=15s
SERVER_TIMEOUT_WRITE=15s
SERVER_TIMEOUT_IDLE=60s

# Application
APP_ENV=production
APP_NAME=NewPay
APP_VERSION=1.0.0
LOG_LEVEL=info

# JWT
# openssl ecparam -genkey -name prime256v1 -noout | openssl ec -outform PEM
JWT_SECRET=CHANGE_ME_GENERATE_NEW_KEY
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Session Configuration
SESSION_TIMEOUT=30m

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@example.com
EMAIL_VERIFICATION_URL=https://yourdomain.com/verify-email
PASSWORD_RESET_URL=https://yourdomain.com/reset-password

# OAuth/SSO Configuration
OAUTH_REDIRECT_URL=https://yourdomain.com/api/v1/auth/oauth/callback
OAUTH_FRONTEND_CALLBACK_URL=https://yourdomain.com/oauth/callback

# OAuth Provider 1 (example)
OAUTH_1_ENABLED=false
OAUTH_1_NAME=GitLab
OAUTH_1_CLIENT_ID=
OAUTH_1_CLIENT_SECRET=
OAUTH_1_AUTH_URL=https://gitlab.com/oauth/authorize
OAUTH_1_TOKEN_URL=https://gitlab.com/oauth/token
OAUTH_1_USER_INFO_URL=https://gitlab.com/api/v4/user
OAUTH_1_GROUP_MAPPING=
OAUTH_1_GROUPS_CLAIM=groups

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
CORS_EXPOSED_HEADERS=Link
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_DURATION=1m

# Registration Settings
ENABLE_REGISTRATION=false
ENABLE_OAUTH_REGISTRATION=false

# Vault
VAULT_ENABLED=true
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=CHANGE_ME_AFTER_VAULT_INIT
VAULT_TRANSIT_MOUNT=transit

# Scheduler
SCHEDULER_ENABLE_DRAFT_REMINDERS=true
SCHEDULER_ENABLE_REVIEWER_SUMMARY=true
SCHEDULER_ENABLE_HASH_CHAIN_VALIDATION=true
SCHEDULER_DRAFT_REMINDER_CRON=0 9 * * 1
SCHEDULER_REVIEWER_SUMMARY_CRON=0 8 * * *
SCHEDULER_HASH_CHAIN_VALIDATION_CRON=0 3 * * *
SCHEDULER_REMINDER_INTERVAL_MINS=10080

# LLM Configuration
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# Frontend Configuration
# API URL that the frontend will use to connect to the backend
# This is passed as a build argument to the frontend Dockerfile
VITE_API_URL=https://yourdomain.com


